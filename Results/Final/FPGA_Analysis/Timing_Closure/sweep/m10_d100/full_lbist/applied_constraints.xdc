####################################################################################
# Constraints from file : 'final_primary.xdc'
####################################################################################

# Basys 3 primary oscillator: 100 MHz. No package assignments for OOC virtual I/O.
create_clock -period 10.000 -name board_clk -waveform {0.000 5.000} [get_ports board_clk]


# User Generated XDC timing constraints 

create_clock -period 100.000 -name virtual_cpu_io -waveform {0.000 50.000}
set_clock_uncertainty 0.100 [get_clocks]
set _xlnx_shared_i0 [get_ports -filter {DIRECTION == IN && NAME != board_clk && NAME != reset_button}]
set_input_delay -clock virtual_cpu_io -max 2.000 $_xlnx_shared_i0
set_input_delay -clock virtual_cpu_io -min 0.500 $_xlnx_shared_i0
set _xlnx_shared_i1 [get_ports -filter {DIRECTION == OUT}]
set_output_delay -clock virtual_cpu_io -max 2.000 $_xlnx_shared_i1
set_output_delay -clock virtual_cpu_io -min 0.500 $_xlnx_shared_i1
set_false_path -from [get_ports reset_button] -to [get_pins -hier -filter {REF_PIN_NAME == CLR || REF_PIN_NAME == PRE || REF_PIN_NAME == RST}]

# Vivado Generated miscellaneous constraints 

#revert back to original instance
current_instance -quiet
